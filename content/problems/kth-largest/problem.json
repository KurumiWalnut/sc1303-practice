{
  "id": "kth-largest",
  "title": "Kth largest element",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Heaps (Week 12)",
  "leetcode": { "number": 215, "slug": "kth-largest-element-in-an-array" },
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    { "name": "Example 1", "expr": "kth_largest([3, 2, 1, 5, 6, 4], 2)", "expected": "5" },
    { "name": "Example 2 (duplicates count separately)", "expr": "kth_largest([3, 2, 3, 1, 2, 4, 5, 5, 6], 4)", "expected": "4" },
    { "name": "One element", "expr": "kth_largest([7], 1)", "expected": "7" },
    { "name": "k equals the length", "expr": "kth_largest([9, 3, 7, 1], 4)", "expected": "1", "hidden": true },
    { "name": "Negative numbers", "expr": "kth_largest([-1, -5, -3, -4], 1)", "expected": "-1", "hidden": true },
    { "name": "All the same", "expr": "kth_largest([5, 5, 5, 5], 3)", "expected": "5", "hidden": true },
    { "name": "Two elements", "expr": "kth_largest([2, 1], 2)", "expected": "1", "hidden": true },
    {
      "name": "100 000 values",
      "data": "import random\nrandom.seed(7)\nnums = [random.randint(-10**4, 10**4) for _ in range(100000)]",
      "expr": "kth_largest(nums, 5000)",
      "expected": "sorted(nums, reverse=True)[4999]",
      "hidden": true
    }
  ]
}
