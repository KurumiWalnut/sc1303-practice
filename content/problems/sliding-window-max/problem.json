{
  "id": "sliding-window-max",
  "title": "Sliding Window Maximum",
  "kind": "leetcode",
  "difficulty": "Hard",
  "source": "Queues (Week 8): a monotonic deque",
  "leetcode": {
    "number": 239,
    "slug": "sliding-window-maximum"
  },
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "max_sliding_window([1, 3, -1, -3, 5, 3, 6, 7], 3)",
      "expected": "[3, 3, 5, 5, 6, 7]"
    },
    {
      "name": "Example 2",
      "expr": "max_sliding_window([1], 1)",
      "expected": "[1]"
    },
    {
      "name": "k = 1",
      "expr": "max_sliding_window([4, -2, 7], 1)",
      "expected": "[4, -2, 7]",
      "hidden": true
    },
    {
      "name": "k = whole list",
      "expr": "max_sliding_window([4, -2, 7, 1], 4)",
      "expected": "[7]",
      "hidden": true
    },
    {
      "name": "Decreasing",
      "expr": "max_sliding_window([9, 8, 7, 6, 5], 2)",
      "expected": "[9, 8, 7, 6]",
      "hidden": true,
      "hint": "Remove the front index once it slides out of the window."
    },
    {
      "name": "Repeated values",
      "expr": "max_sliding_window([2, 2, 2, 1, 2], 3)",
      "expected": "[2, 2, 2]",
      "hidden": true
    },
    {
      "name": "Random small",
      "data": "import random\nrandom.seed(239)\ncases = []\nfor _ in range(40):\n    a = [random.randint(-9, 9) for _ in range(random.randint(1, 12))]\n    cases.append((a, random.randint(1, len(a))))",
      "expr": "[max_sliding_window(a, k) for a, k in cases]",
      "expected": "[[-3], [4], [0, 8, 8], [-6, -8], [6, 6], [9], [1, 1, 1], [9], [9, 9, 6], [6, 1, -1, 5, 7, 7, 3, 6, 6], [-6], [7, 7, 7, 5, 1], [9, 1, -9, -7, 2], [4, 5, 5], [9, -4], [8], [-2], [7, -1, 0, 0, 5, 5, -7, 9], [7, 8, 8], [5, -9, 7, 5, -5, 2], [8], [1, 1, 1, 7, 7], [1], [8], [9, 9], [7], [-2], [7], [7, 7, 5], [0, 1, 1], [3], [9, 9, 9], [-4, 0], [9, 9, 9, 9], [8, -5, 2, -3, -7, -5, -4, 0], [9, 9], [4], [9, 3, 3, 9], [8, 8, 8, 4], [-1, 7, 7, 7, 6, 6, 3]]",
      "hidden": true
    },
    {
      "name": "100 000 numbers, k = 50 000",
      "data": "import random\nrandom.seed(2390)\nnums = [random.randint(-10**4, 10**4) for _ in range(100000)]\nnums.sort(reverse=True)\nnums = nums[:50000] + [random.randint(-10**4, 10**4) for _ in range(50000)]",
      "setup": "r = max_sliding_window(nums, 50000)",
      "expr": "(len(r), r[:5], r[-5:], sum(r))",
      "expected": "(50001, [10000, 10000, 10000, 10000, 10000], [10000, 10000, 10000, 10000, 10000], 499975027)",
      "hidden": true,
      "hint": "Taking max() of every window is O(N k): over a billion steps here."
    }
  ]
}
