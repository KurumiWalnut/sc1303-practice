{
  "id": "longest-consecutive",
  "title": "Longest Consecutive Sequence",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Hash tables (Week 8): a 'seen' set",
  "leetcode": {
    "number": 128,
    "slug": "longest-consecutive-sequence"
  },
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "longest_consecutive([100, 4, 200, 1, 3, 2])",
      "expected": "4"
    },
    {
      "name": "Example 2",
      "expr": "longest_consecutive([0, 3, 7, 2, 5, 8, 4, 6, 0, 1])",
      "expected": "9"
    },
    {
      "name": "Empty",
      "expr": "longest_consecutive([])",
      "expected": "0"
    },
    {
      "name": "Duplicates",
      "expr": "longest_consecutive([1, 2, 0, 1])",
      "expected": "3",
      "hidden": true
    },
    {
      "name": "Negative numbers",
      "expr": "longest_consecutive([-1, -3, -2, 5, 6, -4])",
      "expected": "4",
      "hidden": true
    },
    {
      "name": "Random small",
      "data": "import random\nrandom.seed(128)\narrays = [[random.randint(-10, 10) for _ in range(random.randint(0, 12))] for _ in range(50)]",
      "expr": "[longest_consecutive(a) for a in arrays]",
      "expected": "[2, 1, 1, 2, 1, 1, 2, 2, 0, 1, 1, 3, 0, 6, 1, 5, 1, 1, 2, 0, 2, 2, 4, 2, 1, 4, 1, 3, 4, 7, 3, 3, 1, 1, 2, 3, 2, 1, 4, 1, 4, 2, 2, 2, 1, 1, 3, 1, 1, 3]",
      "hidden": true
    },
    {
      "name": "100 000 numbers",
      "data": "import random\nrandom.seed(1280)\nnums = random.sample(range(-10**9, 10**9, 7), 90000) + list(range(5000, 15000))\nrandom.shuffle(nums)",
      "expr": "longest_consecutive(nums)",
      "expected": "10000",
      "hidden": true,
      "hint": "Only count up from numbers that start a run, and use a set for the lookups."
    }
  ]
}
