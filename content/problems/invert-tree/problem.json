{
  "id": "invert-tree",
  "title": "Invert a binary tree",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Recursive tree patterns",
  "leetcode": {
    "number": 226,
    "slug": "invert-binary-tree"
  },
  "provided": true,
  "timeLimitMs": 3000,
  "tests": [
    {
      "name": "Example 1",
      "expr": "tree_to_list(invert_tree(build_tree([4, 2, 7, 1, 3, 6, 9])))",
      "expected": "[4, 7, 2, 9, 6, 3, 1]"
    },
    {
      "name": "Example 2",
      "expr": "tree_to_list(invert_tree(build_tree([2, 1, 3])))",
      "expected": "[2, 3, 1]"
    },
    {
      "name": "Empty",
      "expr": "tree_to_list(invert_tree(None))",
      "expected": "[]"
    },
    {
      "name": "Uneven tree",
      "expr": "tree_to_list(invert_tree(build_tree([1, 2, None, 3, None, 4])))",
      "expected": "[1, None, 2, None, 3, None, 4]",
      "hidden": true,
      "hint": "Swap children at every level, not just at the root."
    },
    {
      "name": "Invert twice gives the original",
      "expr": "tree_to_list(invert_tree(invert_tree(build_tree([5, 3, 8, 1, 4, None, 9]))))",
      "expected": "[5, 3, 8, 1, 4, None, 9]",
      "hidden": true
    },
    {
      "name": "In-order becomes reversed",
      "data": "import random\nrandom.seed(226)\nvals = random.sample(range(10**6), 3000)",
      "expr": "inorder_values(invert_tree(build_bst(vals))) == sorted(vals, reverse=True)",
      "expected": "True",
      "hidden": true
    }
  ]
}
