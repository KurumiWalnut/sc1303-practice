{
  "id": "height-checker",
  "title": "Height Checker",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Sorting (Week 7)",
  "leetcode": {
    "number": 1051,
    "slug": "height-checker"
  },
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "height_checker([1, 1, 4, 2, 1, 3])",
      "expected": "3"
    },
    {
      "name": "Example 2",
      "expr": "height_checker([5, 1, 2, 3, 4])",
      "expected": "5"
    },
    {
      "name": "Example 3",
      "expr": "height_checker([1, 2, 3, 4, 5])",
      "expected": "0"
    },
    {
      "name": "Don't change the input",
      "setup": "h = [3, 1, 2]",
      "expr": "(height_checker(h), h)",
      "expected": "(3, [3, 1, 2])",
      "hidden": true,
      "hint": "Sort a copy (sorted(...)), not the list itself."
    },
    {
      "name": "All the same",
      "expr": "height_checker([7, 7, 7])",
      "expected": "0",
      "hidden": true
    },
    {
      "name": "100 000 students",
      "data": "import random\nrandom.seed(1051)\nheights = [random.randint(1, 100) for _ in range(100000)]",
      "expr": "height_checker(heights)",
      "expected": "99006",
      "hidden": true
    }
  ]
}
