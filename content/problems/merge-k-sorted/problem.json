{
  "id": "merge-k-sorted",
  "title": "Merge k Sorted Arrays",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Heaps (Week 12)",
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Example 1",
      "expr": "merge_k_sorted([[1, 4, 5], [1, 3, 4], [2, 6]])",
      "expected": "[1, 1, 2, 3, 4, 4, 5, 6]"
    },
    {
      "name": "No lists",
      "expr": "merge_k_sorted([])",
      "expected": "[]"
    },
    {
      "name": "Some lists are empty",
      "expr": "merge_k_sorted([[], [7], []])",
      "expected": "[7]"
    },
    {
      "name": "One list",
      "expr": "merge_k_sorted([[1, 2, 3]])",
      "expected": "[1, 2, 3]",
      "hidden": true
    },
    {
      "name": "Negative numbers and repeats",
      "expr": "merge_k_sorted([[-5, -5, 0], [-6, 10], [-5]])",
      "expected": "[-6, -5, -5, -5, 0, 10]",
      "hidden": true
    },
    {
      "name": "50 small lists",
      "data": "import random\nrandom.seed(23)\nlists = [sorted(random.randint(-50, 50) for _ in range(random.randint(0, 6))) for _ in range(50)]",
      "expr": "merge_k_sorted(lists)",
      "expected": "[-49, -49, -49, -48, -48, -48, -47, -46, -46, -46, -46, -44, -43, -43, -42, -41, -40, -40, -40, -39, -39, -38, -38, -37, -37, -37, -37, -35, -34, -33, -32, -31, -30, -30, -29, -29, -29, -29, -29, -28, -28, -28, -27, -26, -26, -25, -24, -23, -23, -22, -22, -22, -20, -20, -18, -17, -17, -16, -16, -15, -15, -14, -14, -14, -13, -13, -13, -12, -11, -10, -8, -8, -8, -7, -7, -6, -5, -5, -3, -3, -2, 0, 2, 2, 3, 3, 3, 4, 4, 5, 5, 6, 6, 7, 7, 7, 8, 8, 10, 11, 12, 13, 13, 15, 16, 17, 17, 18, 18, 19, 19, 20, 20, 21, 21, 21, 21, 21, 22, 22, 23, 23, 24, 25, 25, 25, 25, 25, 28, 28, 29, 30, 31, 32, 33, 34, 34, 34, 36, 38, 38, 38, 38, 40, 41, 41, 43, 44, 44, 45, 45, 45, 46, 47, 48, 49, 50]",
      "hidden": true
    },
    {
      "name": "2 000 lists, 100 000 values",
      "data": "import random\nrandom.seed(230)\nlists = [sorted(random.randint(-10**6, 10**6) for _ in range(50)) for _ in range(2000)]",
      "setup": "r = merge_k_sorted(lists)",
      "expr": "(len(r), r[:8], r[-8:], sum(i * v for i, v in enumerate(r[::97])))",
      "expected": "(100000, [-999995, -999984, -999970, -999968, -999955, -999950, -999940, -999935], [999886, 999910, 999911, 999935, 999961, 999970, 999985, 999997], 176833213656)",
      "hidden": true,
      "hint": "Finding the smallest head by scanning all k lists each time is O(N k). Keep the heads in a heap."
    }
  ]
}
