{
  "id": "mock2-quicksort-trace",
  "title": "Quicksort pivot trace",
  "kind": "exam",
  "difficulty": "Medium",
  "source": "Mock exam 2, question 3 (quicksort)",
  "timeLimitMs": 3000,
  "tests": [
    {
      "name": "Lecture array",
      "setup": "a = [8, 7, 6, 1, 0, 9, 2]",
      "expr": "(quick_sort_trace(a), a)",
      "expected": "([2, 0, 3, 5], [0, 1, 2, 6, 7, 8, 9])"
    },
    {
      "name": "Exercise array",
      "setup": "a = [1, 7, 4, 1, 10, 9, -2]",
      "expr": "(quick_sort_trace(a), a)",
      "expected": "([0, 1, 4, 2, 6], [-2, 1, 1, 4, 7, 9, 10])"
    },
    {
      "name": "Empty and one value",
      "expr": "(quick_sort_trace([]), quick_sort_trace([5]))",
      "expected": "([], [])",
      "hidden": true
    },
    {
      "name": "Already sorted",
      "expr": "quick_sort_trace([1, 2, 3, 4, 5])",
      "expected": "[4, 3, 2, 1]",
      "hidden": true,
      "hint": "With the last value as the pivot, sorted input puts every pivot at the end."
    },
    {
      "name": "Repeated values",
      "setup": "a = [3, 1, 3, 2, 3]",
      "expr": "(quick_sort_trace(a), a)",
      "expected": "([2, 1, 3], [1, 2, 3, 3, 3])",
      "hidden": true,
      "hint": "Only swap when arr[a] is strictly smaller than the pivot."
    },
    {
      "name": "Two values",
      "expr": "[quick_sort_trace([2, 1]), quick_sort_trace([1, 2])]",
      "expected": "[[0], [1]]",
      "hidden": true
    },
    {
      "name": "5 000 random values",
      "data": "import random\nrandom.seed(1033)\nvalues = [random.randint(0, 10**6) for _ in range(5000)]",
      "setup": "a = values[:]\nt = quick_sort_trace(a)",
      "expr": "(len(t), t[:10], sum(t), a == sorted(values))",
      "expected": "(3325, [473, 290, 137, 112, 89, 48, 0, 21, 17, 2], 8314016, True)",
      "hidden": true
    }
  ]
}
