{
  "id": "cheapest-flights-k-stops",
  "title": "Cheapest Flights Within K Stops",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Shortest paths (Week 12): a variation",
  "leetcode": {
    "number": 787,
    "slug": "cheapest-flights-within-k-stops"
  },
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "find_cheapest_price(4, [[0, 1, 100], [1, 2, 100], [2, 0, 100], [1, 3, 600], [2, 3, 200]], 0, 3, 1)",
      "expected": "700"
    },
    {
      "name": "Example 2",
      "expr": "find_cheapest_price(3, [[0, 1, 100], [1, 2, 100], [0, 2, 500]], 0, 2, 1)",
      "expected": "200"
    },
    {
      "name": "Example 3",
      "expr": "find_cheapest_price(3, [[0, 1, 100], [1, 2, 100], [0, 2, 500]], 0, 2, 0)",
      "expected": "500"
    },
    {
      "name": "Cheapest route needs too many stops",
      "expr": "find_cheapest_price(5, [[0, 1, 5], [1, 2, 5], [0, 3, 2], [3, 1, 2], [1, 4, 1], [4, 2, 1]], 0, 2, 2)",
      "expected": "7",
      "hidden": true,
      "hint": "Keeping only the cheapest price per city loses a pricier route with fewer stops."
    },
    {
      "name": "No route",
      "expr": "find_cheapest_price(3, [[0, 1, 10]], 0, 2, 2)",
      "expected": "-1",
      "hidden": true
    },
    {
      "name": "Source is the destination",
      "expr": "find_cheapest_price(3, [[0, 1, 10], [1, 0, 10]], 0, 0, 1)",
      "expected": "0",
      "hidden": true
    },
    {
      "name": "One round uses old prices only",
      "expr": "find_cheapest_price(4, [[0, 1, 1], [1, 2, 1], [2, 3, 1], [0, 3, 10]], 0, 3, 0)",
      "expected": "10",
      "hidden": true,
      "hint": "In each round, read from a copy of the previous round's prices."
    },
    {
      "name": "Random small",
      "data": "import random\nrandom.seed(787)\ncases = []\nfor _ in range(40):\n    n = random.randint(2, 6)\n    pairs = sorted({tuple(random.sample(range(n), 2)) for _ in range(random.randint(0, 10))})\n    fl = [[a, b, random.randint(1, 50)] for a, b in pairs]\n    cases.append((n, fl, 0, n - 1, random.randint(0, n - 1)))",
      "expr": "[find_cheapest_price(*c) for c in cases]",
      "expected": "[6, 12, -1, -1, -1, -1, -1, -1, 28, 18, -1, 50, -1, 42, -1, 26, -1, 32, -1, 37, 45, 22, 50, 29, 44, -1, 23, -1, 37, 44, 6, 30, 48, 29, -1, -1, -1, 32, 61, -1]",
      "hidden": true
    },
    {
      "name": "100 cities, every flight",
      "data": "import random\nrandom.seed(7870)\nflights = [[a, b, random.randint(1, 10**4)] for a in range(100) for b in range(100) if a != b and random.random() < 0.5]",
      "expr": "[find_cheapest_price(100, flights, 0, 99, k) for k in (0, 1, 3, 10, 99)]",
      "expected": "[-1, 856, 856, 856, 856]",
      "hidden": true
    }
  ]
}
