    {
      "name": "Example 2",
      "expr": "first_uniq_char(\"loveleetcode\")",
      "expected": "2"
    },
    {
      "name": "Example 3",
      "expr": "first_uniq_char(\"aabb\")",
      "expected": "-1"
    },
    {
      "name": "Course example",
      "expr": "first_uniq_char(\"swiss\")",
      "expected": "1",
      "hidden": true
    },
    {
      "name": "One letter",
      "expr": "first_uniq_char(\"z\")",
      "expected": "0",
      "hidden": true
    },
    {
      "name": "Unique letter at the end",
      "expr": "first_uniq_char(\"aabbccd\")",
      "expected": "6",
      "hidden": true
    },
    {
      "name": "Random short",
      "data": "import random\nrandom.seed(387)\nwords = [''.join(random.choices('abcd', k=random.randint(1, 10))) for _ in range(50)]",
      "expr": "[first_uniq_char(w) for w in words]",
      "expected": "[4, -1, 0, 4, 3, 2, 0, 0, 1, 4, 0, 0, 4, 0, 0, 3, 2, 0, -1, 0, 0, -1, 0, -1, 0, 2, -1, -1, 2, -1, 0, 0, 1, -1, 0, -1, 1, 4, -1, 5, 0, 5, 0, 0, 6, 2, 3, 1, -1, -1]",
      "hidden": true
    },
    {
      "name": "100 000 letters, unique one near the end",
      "data": "import random\nrandom.seed(3870)\nbody = random.choices('abcdefghijklmnopqrstuvwxy', k=99990) + list('abcdefghijklmnopqrstuvwxy')\ns = ''.join(body[:99000]) + 'z' + ''.join(body[99000:])",
      "expr": "first_uniq_char(s)",
      "expected": "99000",
      "hidden": true,
      "hint": "Count every letter once with a dict, then find the first with a count of 1."
    }
  ]
