{
  "id": "quicksort-impl",
  "title": "In-place quicksort and quickselect",
  "kind": "base",
  "difficulty": "Medium",
  "source": "Week 10 lecture (Quicksort); Week 9 seminar, coding exercise 2",
  "provided": true,
  "timeLimitMs": 3000,
  "tests": [
    {
      "name": "quick_sort",
      "setup": "a = [8, 7, 6, 1, 0, 9, 2]\nquick_sort(a)",
      "expr": "a",
      "expected": "[0, 1, 2, 6, 7, 8, 9]"
    },
    {
      "name": "quickselect",
      "expr": "[quickselect([8, 7, 6, 1, 0, 9, 2], k) for k in range(7)]",
      "expected": "[0, 1, 2, 6, 7, 8, 9]"
    },
    {
      "name": "Sorts in place and returns nothing",
      "setup": "a = [3, 1, 2]\nresult = quick_sort(a)",
      "expr": "(result, a)",
      "expected": "(None, [1, 2, 3])",
      "hidden": true
    },
    {
      "name": "Empty and one element",
      "setup": "a = []\nquick_sort(a)\nb = [5]\nquick_sort(b)",
      "expr": "(a, b)",
      "expected": "([], [5])",
      "hidden": true
    },
    {
      "name": "Duplicates",
      "setup": "a = [4, 1, 4, 2, 4, 1, 3]\nquick_sort(a)",
      "expr": "a",
      "expected": "[1, 1, 2, 3, 4, 4, 4]",
      "hidden": true
    },
    {
      "name": "Only part of the array",
      "setup": "a = [9, 8, 7, 6, 5, 4]\nquick_sort(a, 1, 4)",
      "expr": "a",
      "expected": "[9, 5, 6, 7, 8, 4]",
      "hidden": true
    },
    {
      "name": "quickselect with duplicates",
      "expr": "[quickselect([5, 1, 5, 3, 5, 1], k) for k in range(6)]",
      "expected": "[1, 1, 3, 5, 5, 5]",
      "hidden": true
    },
    {
      "name": "Sorted input (worst case, 600 values)",
      "setup": "a = list(range(600))\nquick_sort(a)",
      "expr": "a == list(range(600))",
      "expected": "True",
      "hidden": true
    },
    {
      "name": "20 000 random values",
      "data": "import random\nrandom.seed(1010)\nvalues = [random.randint(-10**6, 10**6) for _ in range(20000)]",
      "setup": "a = values[:]\nquick_sort(a)",
      "expr": "(a[:5], a[-5:], a == sorted(values))",
      "expected": "([-999985, -999740, -999716, -999674, -999478], [999729, 999747, 999801, 999803, 999992], True)",
      "hidden": true
    },
    {
      "name": "Median of 200 001 values",
      "data": "import random\nrandom.seed(1011)\nvalues = random.sample(range(10**7), 200001)",
      "setup": "a = values[:]",
      "expr": "quickselect(a, 100000)",
      "expected": "4983700",
      "hidden": true,
      "hint": "Recurse into one side only, and don't sort the whole list."
    }
  ]
}
