{
  "id": "bst-delete-impl",
  "title": "BST deletion with the successor",
  "kind": "base",
  "difficulty": "Medium",
  "source": "Week 11 lecture (BST deletion)",
  "provided": true,
  "timeLimitMs": 3000,
  "tests": [
    {
      "name": "Delete a leaf",
      "setup": "root = build_bst([50, 25, 75, 10, 33, 56, 89, 4, 11, 30, 40, 52, 61, 82, 95])",
      "expr": "tree_to_list(delete(4, root))",
      "expected": "[50, 25, 75, 10, 33, 56, 89, None, 11, 30, 40, 52, 61, 82, 95]"
    },
    {
      "name": "Two children: successor is a leaf",
      "setup": "root = build_bst([50, 25, 75, 10, 33, 56, 89, 4, 11, 30, 40, 52, 61, 82, 95])",
      "expr": "tree_to_list(delete(56, root))",
      "expected": "[50, 25, 75, 10, 33, 61, 89, 4, 11, 30, 40, 52, None, 82, 95]"
    },
    {
      "name": "Delete the root",
      "setup": "root = build_bst([50, 25, 75, 10, 33, 56, 89, 4, 11, 30, 40, 52, 61, 82, 95])",
      "expr": "tree_to_list(delete(50, root))",
      "expected": "[52, 25, 75, 10, 33, 56, 89, 4, 11, 30, 40, None, 61, 82, 95]"
    },
    {
      "name": "One child",
      "setup": "root = build_bst([50, 25, 75, 10, 33, 4])",
      "expr": "tree_to_list(delete(10, root))",
      "expected": "[50, 25, 75, 4, 33]",
      "hidden": true,
      "hint": "With one child, the child moves up into the deleted node's place."
    },
    {
      "name": "Successor has a right child",
      "setup": "root = build_bst([50, 25, 75, 56, 89, 52, 61, 55])",
      "expr": "tree_to_list(delete(50, root))",
      "expected": "[52, 25, 75, None, None, 56, 89, 55, 61]",
      "hidden": true,
      "hint": "The successor's right child takes the successor's old place."
    },
    {
      "name": "Successor is the right child itself",
      "setup": "root = build_bst([50, 25, 75, 89, 95])",
      "expr": "tree_to_list(delete(50, root))",
      "expected": "[75, 25, 89, None, None, None, 95]",
      "hidden": true,
      "hint": "If the right child has no left child, it is the successor, and its own right subtree stays attached."
    },
    {
      "name": "Value not in the tree",
      "setup": "root = build_bst([50, 25, 75])",
      "expr": "tree_to_list(delete(99, root))",
      "expected": "[50, 25, 75]",
      "hidden": true
    },
    {
      "name": "Delete the only node",
      "expr": "tree_to_list(delete(7, TreeNode(7)))",
      "expected": "[]",
      "hidden": true
    },
    {
      "name": "Delete everything",
      "setup": "root = build_bst([4, 2, 6, 1, 3, 5, 7])\nfor v in [4, 1, 6, 2, 7, 3, 5]:\n    root = delete(v, root)",
      "expr": "tree_to_list(root)",
      "expected": "[]",
      "hidden": true
    },
    {
      "name": "3 000 values, delete half",
      "data": "import random\nrandom.seed(450)\nvals = random.sample(range(10**6), 3000)\ngone = set(random.sample(vals, 1500))\nkeep = [v for v in vals if v not in gone]",
      "setup": "root = build_bst(vals)\nfor v in gone:\n    root = delete(v, root)",
      "expr": "inorder_values(root) == sorted(keep)",
      "expected": "True",
      "hidden": true
    }
  ]
}
