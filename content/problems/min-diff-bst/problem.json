{
  "id": "min-diff-bst",
  "title": "Minimum difference in a BST",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "BST + in-order traversal",
  "leetcode": {
    "number": 530,
    "slug": "minimum-absolute-difference-in-bst"
  },
  "provided": true,
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Example 1",
      "expr": "min_diff(build_tree([4, 2, 6, 1, 3]))",
      "expected": "1"
    },
    {
      "name": "Example 2",
      "expr": "min_diff(build_tree([1, 0, 48, None, None, 12, 49]))",
      "expected": "1"
    },
    {
      "name": "Two nodes",
      "expr": "min_diff(build_tree([10, None, 25]))",
      "expected": "15",
      "hidden": true
    },
    {
      "name": "Closest pair across the root",
      "expr": "min_diff(build_tree([100, 50, 150, None, 99, 101]))",
      "expected": "1",
      "hidden": true,
      "hint": "The closest values may be in different subtrees. Sort them first (in-order traversal)."
    },
    {
      "name": "Negative values",
      "expr": "min_diff(build_bst([-20, -50, 30, -21, 0]))",
      "expected": "1",
      "hidden": true
    },
    {
      "name": "5 000 values",
      "data": "import random\nrandom.seed(530)\nroot = build_bst(random.sample(range(10**7), 5000))",
      "expr": "min_diff(root)",
      "expected": "1",
      "hidden": true
    }
  ]
}
