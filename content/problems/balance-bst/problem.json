{
  "id": "balance-bst",
  "title": "Balance a Binary Search Tree",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "AVL balance (Week 12)",
  "leetcode": {
    "number": 1382,
    "slug": "balance-a-binary-search-tree"
  },
  "provided": true,
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "check_balanced_bst(balance_bst(build_bst([1, 2, 3, 4])), [1, 2, 3, 4])",
      "expected": "'ok'"
    },
    {
      "name": "Already balanced",
      "expr": "check_balanced_bst(balance_bst(build_bst([2, 1, 3])), [1, 2, 3])",
      "expected": "'ok'"
    },
    {
      "name": "One node",
      "expr": "tree_to_list(balance_bst(build_bst([5])))",
      "expected": "[5]",
      "hidden": true
    },
    {
      "name": "Left chain",
      "expr": "check_balanced_bst(balance_bst(build_bst(range(10, 0, -1))), list(range(1, 11)))",
      "expected": "'ok'",
      "hidden": true
    },
    {
      "name": "Zig-zag",
      "expr": "check_balanced_bst(balance_bst(build_bst([1, 100, 2, 99, 3, 98, 4, 97])), [1, 2, 3, 4, 97, 98, 99, 100])",
      "expected": "'ok'",
      "hidden": true
    },
    {
      "name": "800-deep chain",
      "expr": "check_balanced_bst(balance_bst(build_bst(range(800))), list(range(800)))",
      "expected": "'ok'",
      "hidden": true
    },
    {
      "name": "20 000 random values",
      "data": "import random\nrandom.seed(1382)\nvalues = random.sample(range(10**6), 20000)\nroot = build_bst(values)",
      "expr": "check_balanced_bst(balance_bst(root), sorted(values))",
      "expected": "'ok'",
      "hidden": true
    }
  ]
}
