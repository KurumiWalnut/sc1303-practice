      "hidden": true
    },
    {
      "name": "100 000 numbers",
      "data": "import random\nrandom.seed(2950)\nops = []\nfor i in range(100000):\n    ops.append(('add', random.randint(-10**5, 10**5)))\n    if i % 2:\n        ops.append(('median',))",
      "setup": "r = run_ops(ops)",
      "expr": "(len(r), r[:5], r[-5:], sum(r))",
      "expected": "(50000, [-6882.5, -10635.5, 359.0, 359.0, 359.0], [197.5, 201.0, 201.0, 202.0, 201.0], 13230692.5)",
