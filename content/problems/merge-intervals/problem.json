{
  "id": "merge-intervals",
  "title": "Merge Intervals",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Week 7 seminar, exercise 6",
  "leetcode": {
    "number": 56,
    "slug": "merge-intervals"
  },
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Course example",
      "expr": "merge_intervals([[2, 6], [15, 18], [8, 10], [1, 3]])",
      "expected": "[[1, 6], [8, 10], [15, 18]]"
    },
    {
      "name": "Touching intervals",
      "expr": "merge_intervals([[1, 4], [4, 5]])",
      "expected": "[[1, 5]]"
    },
    {
      "name": "One inside another",
      "expr": "merge_intervals([[1, 10], [2, 3], [4, 5]])",
      "expected": "[[1, 10]]",
      "hidden": true,
      "hint": "Use max(end, next end): a short interval inside a long one doesn't shrink it."
    },
    {
      "name": "Unsorted input",
      "expr": "merge_intervals([[5, 6], [1, 2], [3, 4]])",
      "expected": "[[1, 2], [3, 4], [5, 6]]",
      "hidden": true
    },
    {
      "name": "One interval",
      "expr": "merge_intervals([[0, 0]])",
      "expected": "[[0, 0]]",
      "hidden": true
    },
    {
      "name": "Random small",
