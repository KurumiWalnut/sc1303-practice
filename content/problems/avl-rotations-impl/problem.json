{
  "id": "avl-rotations-impl",
  "title": "AVL rotations",
  "kind": "base",
  "difficulty": "Medium",
  "source": "AVL_tree_template.py; Week 12 lecture (AVL Tree)",
  "provided": true,
  "timeLimitMs": 3000,
  "tests": [
    {
      "name": "Rotate left",
      "setup": "r = _rotate_left(make_node(10, None, make_node(20, None, make_node(30))))",
      "expr": "(preorder(r), r.height, r.left.height, r.right.height)",
      "expected": "([20, 10, 30], 2, 1, 1)"
    },
    {
      "name": "Rotate right",
      "setup": "r = _rotate_right(make_node(30, make_node(20, make_node(10))))",
      "expr": "(preorder(r), r.height, r.left.height, r.right.height)",
      "expected": "([20, 10, 30], 2, 1, 1)"
    },
    {
      "name": "The template's four inserts",
      "expr": "[preorder(build_avl(seq)) for seq in ([10, 20, 30], [30, 20, 10], [30, 10, 20], [10, 30, 20])]",
      "expected": "[[20, 10, 30], [20, 10, 30], [20, 10, 30], [20, 10, 30]]"
    },
    {
      "name": "Rotate left moves T2 across",
      "setup": "r = _rotate_left(make_node(10, make_node(5), make_node(20, make_node(15), make_node(30, None, make_node(40)))))",
      "expr": "(preorder(r), r.height, r.left.height, check_avl(r))",
      "expected": "([20, 10, 5, 15, 30, 40], 3, 2, 'ok')",
      "hidden": true,
      "hint": "y's old left subtree (15) becomes x's right subtree."
    },
    {
      "name": "Rotate right moves T2 across",
      "setup": "r = _rotate_right(make_node(40, make_node(20, make_node(10, make_node(5)), make_node(30)), make_node(50)))",
      "expr": "(preorder(r), r.height, r.right.height, check_avl(r))",
      "expected": "([20, 10, 5, 40, 30, 50], 3, 2, 'ok')",
      "hidden": true
    },
    {
      "name": "Heights are updated in the right order",
      "setup": "r = _rotate_left(make_node(1, None, make_node(2, None, make_node(3, None, make_node(4)))))",
      "expr": "[(n.value, n.height) for n in (r, r.left, r.right)]",
      "expected": "[(2, 3), (1, 1), (3, 2)]",
      "hidden": true,
      "hint": "Update the node that moved down first, then the new root."
    },
    {
      "name": "Insert 1 to 15 in order",
      "setup": "root = build_avl(range(1, 16))",
      "expr": "(preorder(root), root.height)",
      "expected": "([8, 4, 2, 1, 3, 6, 5, 7, 12, 10, 9, 11, 14, 13, 15], 4)",
      "hidden": true
    },
    {
      "name": "Double rotations deeper down",
      "setup": "root = build_avl([50, 20, 70, 10, 30, 25, 27, 26, 80, 75, 77])",
      "expr": "(preorder(root), check_avl(root))",
      "expected": "([30, 20, 10, 26, 25, 27, 70, 50, 77, 75, 80], 'ok')",
      "hidden": true
    },
    {
      "name": "2 000 sorted values",
      "setup": "root = build_avl(range(2000))",
      "expr": "(root.height, check_avl(root))",
      "expected": "(11, 'ok')",
      "hidden": true
    },
    {
      "name": "10 000 random values",
      "data": "import random\nrandom.seed(1212)\nvalues = [random.randint(0, 10**6) for _ in range(10000)]",
      "setup": "root = build_avl(values)",
      "expr": "(root.height, check_avl(root), preorder(root)[:10])",
      "expected": "(16, 'ok', [446388, 187186, 89271, 53661, 32616, 11125, 6628, 3290, 2140, 849])",
      "hidden": true,
      "timeLimitMs": 6000
    }
  ]
}
