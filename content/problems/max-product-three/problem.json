{
  "id": "max-product-three",
  "title": "Maximum Product of Three Numbers",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Week 9 seminar, exercise 5",
  "leetcode": {
    "number": 628,
    "slug": "maximum-product-of-three-numbers"
  },
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "maximum_product([1, 2, 3])",
      "expected": "6"
    },
    {
      "name": "Example 2",
      "expr": "maximum_product([1, 2, 3, 4])",
      "expected": "24"
    },
    {
      "name": "Example 3",
      "expr": "maximum_product([-10, -10, 1, 3])",
      "expected": "300"
    },
    {
      "name": "All negative",
      "expr": "maximum_product([-1, -2, -3, -4])",
      "expected": "-6",
      "hidden": true,
      "hint": "With only negatives, the three closest to zero win."
    },
    {
      "name": "Zeros",
      "expr": "[maximum_product([0, 0, 0]), maximum_product([-5, 0, 2, 3]), maximum_product([-3, -2, 0])]",
      "expected": "[0, 0, 0]",
      "hidden": true
    },
    {
      "name": "Random small",
      "data": "import random\nrandom.seed(628)\narrays = [[random.randint(-20, 20) for _ in range(random.randint(3, 9))] for _ in range(60)]",
      "expr": "[maximum_product(a) for a in arrays]",
      "expected": "[2925, 1620, 4560, 72, 5400, 0, 24, 765, 1782, 5184, 2520, 2574, 6460, -630, 0, 5491, 5760, 3344, 3276, 6400, 2700, 960, 4940, 2890, 1980, 5040, -252, 375, 4860, 1386, 2400, 2023, 3276, 504, 1620, 1350, 2880, 1026, 324, 2574, 1309, 4864, 3136, 6498, 2268, 1782, 2964, 5508, 2873, 3705, 200, 1944, 480, 5184, 2340, 1836, 845, 4320, -128, 425]",
      "hidden": true
    },
    {
      "name": "10 000 numbers",
      "data": "import random\nrandom.seed(6280)\nnums = [random.randint(-1000, 1000) for _ in range(10000)]",
      "expr": "maximum_product(nums)",
      "expected": "1000000000",
      "hidden": true
    }
  ]
}
