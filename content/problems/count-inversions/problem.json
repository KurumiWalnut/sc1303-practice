{
  "id": "count-inversions",
  "title": "Minimum adjacent swaps (count inversions)",
  "kind": "leetcode",
  "difficulty": "Hard",
  "source": "Week 7: bubble sort swaps = inversions",
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "count_inversions([2, 4, 1, 3, 5])",
      "expected": "3"
    },
    {
      "name": "Example 2",
      "expr": "count_inversions([1, 2, 3])",
      "expected": "0"
    },
    {
      "name": "Example 3",
      "expr": "count_inversions([3, 2, 1])",
      "expected": "3"
    },
    {
      "name": "Equal values",
      "expr": "count_inversions([2, 2, 1, 1])",
      "expected": "4",
      "hidden": true,
      "hint": "Equal values are not out of order."
    },
    {
      "name": "Empty and one value",
      "expr": "[count_inversions([]), count_inversions([4])]",
      "expected": "[0, 0]",
      "hidden": true
    },
    {
      "name": "Random small",
      "data": "import random\nrandom.seed(493)\narrays = [[random.randint(0, 6) for _ in range(random.randint(0, 12))] for _ in range(50)]",
      "expr": "[count_inversions(a) for a in arrays]",
      "expected": "[4, 0, 7, 2, 0, 10, 4, 3, 12, 13, 12, 28, 1, 4, 1, 18, 3, 0, 0, 15, 0, 26, 0, 28, 8, 27, 17, 3, 5, 0, 0, 3, 4, 3, 4, 5, 0, 2, 10, 0, 34, 0, 10, 33, 17, 23, 1, 4, 0, 0]",
      "hidden": true
    },
    {
      "name": "Matches bubble sort's swaps",
      "data": "import random\nrandom.seed(4930)\nnums = [random.randint(0, 100) for _ in range(800)]",
      "expr": "count_inversions(nums)",
      "expected": "157175",
      "hidden": true
    },
    {
      "name": "50 000 values",
      "data": "import random\nrandom.seed(4931)\nnums = [random.randint(0, 10**9) for _ in range(50000)]",
      "expr": "count_inversions(nums)",
      "expected": "625677644",
      "hidden": true,
      "hint": "Counting every pair is over a billion checks. Count while merge sorting."
    },
    {
      "name": "50 000 in reverse",
      "expr": "count_inversions(list(range(50000, 0, -1)))",
      "expected": "1249975000",
      "hidden": true
    }
  ]
}
