{
  "id": "mock1-house-robber",
  "title": "Non-adjacent maximum sum",
  "kind": "exam",
  "difficulty": "Medium",
  "source": "Mock exam 1, question 4 (dynamic programming)",
  "leetcode": { "number": 198, "slug": "house-robber" },
  "timeLimitMs": 3000,
  "tests": [
    { "name": "Example 1", "expr": "max_non_adjacent([1, 2, 3, 1])", "expected": "4" },
    { "name": "Example 2", "expr": "max_non_adjacent([2, 7, 9, 3, 1])", "expected": "12" },
    { "name": "One house", "expr": "max_non_adjacent([5])", "expected": "5" },
    { "name": "Empty street", "expr": "max_non_adjacent([])", "expected": "0", "hidden": true },
    { "name": "Skipping two in a row", "expr": "max_non_adjacent([2, 1, 1, 2])", "expected": "4", "hidden": true, "hint": "The best choice can skip more than one house in a row." },
    { "name": "Middle is best", "expr": "max_non_adjacent([1, 3, 1])", "expected": "3", "hidden": true },
    { "name": "Both ends", "expr": "max_non_adjacent([10, 1, 1, 10])", "expected": "20", "hidden": true },
    { "name": "All zeros", "expr": "max_non_adjacent([0, 0, 0])", "expected": "0", "hidden": true },
    {
      "name": "60 houses",
      "data": "nums = [(i * 37) % 101 for i in range(60)]",
      "expr": "max_non_adjacent(nums)",
      "expected": "1792",
      "hidden": true,
      "hint": "Plain recursion tries about 2^N combinations. Remember answers you've already worked out (memoisation), or fill a table from the left."
    },
    {
      "name": "500 houses",
      "data": "import random\nrandom.seed(198)\nnums = [random.randint(0, 400) for _ in range(500)]",
      "expr": "max_non_adjacent(nums)",
      "expected": "56437",
      "hidden": true
    }
  ]
}
