{
  "id": "pow-x-n",
  "title": "Pow(x, n)",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Recursion (Week 9): divide and conquer",
  "leetcode": {
    "number": 50,
    "slug": "powx-n"
  },
  "timeLimitMs": 3000,
  "checker": "def check(actual, expected):\n    try:\n        a = float(actual)\n    except (TypeError, ValueError):\n        return False\n    return abs(a - expected) <= 1e-6 * max(1.0, abs(expected))\n",
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "my_pow(2.0, 10)",
      "expected": "1024.0"
    },
    {
      "name": "Example 2",
      "expr": "my_pow(2.1, 3)",
      "expected": "9.261000000000001"
    },
    {
      "name": "Example 3",
      "expr": "my_pow(2.0, -2)",
      "expected": "0.25"
    },
    {
      "name": "n = 0",
      "expr": "my_pow(37.5, 0)",
      "expected": "1.0",
      "hidden": true
    },
    {
      "name": "Negative x",
      "expr": "my_pow(-2.0, 5)",
      "expected": "-32.0",
      "hidden": true
    },
    {
      "name": "Huge n",
      "expr": "my_pow(1.0000001, 2**31 - 1)",
      "expected": "1.8366447404298937e+93",
      "hidden": true,
      "hint": "A loop of 2 billion multiplications is far too slow. Halve n each time."
    },
    {
      "name": "Huge negative n",
      "expr": "my_pow(0.99999999, -2**31)",
      "expected": "2120328075.1615222",
      "hidden": true
    },
    {
      "name": "x = 1 and x = -1",
      "expr": "my_pow(-1.0, 2**31 - 1)",
      "expected": "-1.0",
      "hidden": true
    },
    {
      "name": "Many calls",
      "expr": "sum(my_pow(1.0001, n) for n in range(-5000, 5000))",
      "expected": "10421.342337733064",
      "hidden": true
    }
  ]
}
