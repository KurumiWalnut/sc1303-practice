{
  "id": "third-max",
  "title": "Third Maximum Number",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Selection sort (Week 7): picking the largest",
  "leetcode": {
    "number": 414,
    "slug": "third-maximum-number"
  },
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Example 1",
      "expr": "third_max([3, 2, 1])",
      "expected": "1"
    },
    {
      "name": "Example 2",
      "expr": "third_max([1, 2])",
      "expected": "2"
    },
    {
      "name": "Example 3",
      "expr": "third_max([2, 2, 3, 1])",
      "expected": "1"
    },
    {
      "name": "Repeats of the maximum",
      "expr": "third_max([5, 5, 5, 4])",
      "expected": "5",
      "hidden": true,
      "hint": "Only distinct values count."
    },
    {
      "name": "Negative numbers",
      "expr": "third_max([-1, -2, -3, -4])",
      "expected": "-3",
      "hidden": true
    },
    {
      "name": "Random small",
      "data": "import random\nrandom.seed(414)\narrays = [[random.randint(-4, 4) for _ in range(random.randint(1, 8))] for _ in range(50)]",
      "expr": "[third_max(a) for a in arrays]",
      "expected": "[0, -2, -2, -2, 3, 0, 3, 1, -4, 4, 0, 4, 0, -1, 0, 0, 3, -3, 2, -2, -1, 0, -2, -2, -3, -3, 2, -2, -3, 1, -4, 2, 2, -1, -2, 1, 4, 4, 0, -3, 1, 0, 1, -1, 2, -2, 0, -2, 3, -3]",
      "hidden": true
    },
    {
      "name": "100 000 values",
      "data": "import random\nrandom.seed(4140)\nnums = [random.randint(-2**31, 2**31 - 1) for _ in range(100000)]",
      "expr": "third_max(nums)",
      "expected": "2147412345",
      "hidden": true
    }
  ]
}
