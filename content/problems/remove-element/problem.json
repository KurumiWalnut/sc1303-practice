{
  "id": "remove-element",
  "title": "Remove Element",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Array operations (Week 5)",
  "leetcode": {
    "number": 27,
    "slug": "remove-element"
  },
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Example 1",
      "setup": "nums = [3, 2, 2, 3]\nk = remove_element(nums, 3)",
      "expr": "(k, sorted(nums[:k]))",
      "expected": "(2, [2, 2])"
    },
    {
      "name": "Example 2",
      "setup": "nums = [0, 1, 2, 2, 3, 0, 4, 2]\nk = remove_element(nums, 2)",
      "expr": "(k, sorted(nums[:k]))",
      "expected": "(5, [0, 0, 1, 3, 4])"
    },
    {
      "name": "Nothing to remove",
      "setup": "nums = [1, 2, 3]\nk = remove_element(nums, 9)",
      "expr": "(k, sorted(nums[:k]))",
      "expected": "(3, [1, 2, 3])",
      "hidden": true
    },
    {
      "name": "Remove everything",
      "setup": "nums = [4, 4, 4]\nk = remove_element(nums, 4)",
      "expr": "k",
      "expected": "0",
      "hidden": true
    },
    {
      "name": "Empty",
      "expr": "remove_element([], 1)",
      "expected": "0",
      "hidden": true
    },
    {
      "name": "In place",
      "setup": "nums = [1, 0, 1, 0]\nk = remove_element(nums, 1)",
      "expr": "(k, sorted(nums[:k]))",
      "expected": "(2, [0, 0])",
      "hidden": true,
      "hint": "Write the kept values into the front of the list you were given."
    },
    {
      "name": "100 000 values",
      "data": "import random\nrandom.seed(27)\nstart = [random.randint(0, 9) for _ in range(100000)]\nval = 3",
      "setup": "nums = start[:]\nk = remove_element(nums, val)",
      "expr": "(k, sum(nums[:k]), val in nums[:k])",
      "expected": "(90076, 419654, False)",
      "hidden": true
    }
  ]
}
