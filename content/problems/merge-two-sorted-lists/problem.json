{
  "id": "merge-two-sorted-lists",
  "title": "Merge two sorted lists",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Week 10 seminar, exercise 5",
  "leetcode": {
    "number": 21,
    "slug": "merge-two-sorted-lists"
  },
  "provided": true,
  "timeLimitMs": 3000,
  "tests": [
    {
      "name": "Seminar example",
      "expr": "to_pylist(merge_two_lists(build_list([1, 2, 5]), build_list([1, 3, 4])))",
      "expected": "[1, 1, 2, 3, 4, 5]"
    },
    {
      "name": "Both empty",
      "expr": "to_pylist(merge_two_lists(None, None))",
      "expected": "[]"
    },
    {
      "name": "One empty",
      "expr": "to_pylist(merge_two_lists(None, build_list([0])))",
      "expected": "[0]"
    },
    {
      "name": "All of one list first",
      "expr": "to_pylist(merge_two_lists(build_list([5, 6]), build_list([1, 2, 3])))",
      "expected": "[1, 2, 3, 5, 6]",
      "hidden": true
    },
    {
      "name": "Duplicates",
      "expr": "to_pylist(merge_two_lists(build_list([2, 2]), build_list([2, 2])))",
      "expected": "[2, 2, 2, 2]",
      "hidden": true
    },
    {
      "name": "Reuses the original nodes",
      "setup": "a = build_list([1, 2, 4])\nb = build_list([1, 3, 4])\nbefore = set()\nfor h in (a, b):\n    while h is not None:\n        before.add(id(h))\n        h = h.next\nmerged = merge_two_lists(a, b)\nafter = set()\nh = merged\nwhile h is not None:\n    after.add(id(h))\n    h = h.next",
      "expr": "(to_pylist(merged), after == before)",
      "expected": "([1, 1, 2, 3, 4, 4], True)",
      "hidden": true,
      "hint": "Link the existing nodes together instead of creating new ones (a dummy head is fine)."
    },
    {
      "name": "30 000 nodes each",
      "data": "evens = build_list(list(range(0, 60000, 2)))\nodds = build_list(list(range(1, 60000, 2)))",
      "expr": "to_pylist(merge_two_lists(evens, odds)) == list(range(60000))",
      "expected": "True",
      "hidden": true,
      "hint": "A recursive merge goes one call deep per node. Use a loop."
    }
  ]
}
