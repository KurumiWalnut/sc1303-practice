{
  "id": "search-insert-position",
  "title": "Search insert position",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Ordered-array insertion (Week 6)",
  "leetcode": { "number": 35, "slug": "search-insert-position" },
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    { "name": "Found", "expr": "search_insert([1, 3, 5, 6], 5)", "expected": "2" },
    { "name": "Goes in the middle", "expr": "search_insert([1, 3, 5, 6], 2)", "expected": "1" },
    { "name": "Goes at the end", "expr": "search_insert([1, 3, 5, 6], 7)", "expected": "4" },
    { "name": "Goes at the start", "expr": "search_insert([1, 3, 5, 6], 0)", "expected": "0", "hidden": true },
    { "name": "One element", "expr": "[search_insert([1], t) for t in (0, 1, 2)]", "expected": "[0, 0, 1]", "hidden": true },
    {
      "name": "Every gap",
      "expr": "[search_insert([10, 20, 30, 40], v) for v in [5, 10, 15, 20, 25, 30, 35, 40, 45]]",
      "expected": "[0, 0, 1, 1, 2, 2, 3, 3, 4]",
      "hidden": true,
      "hint": "When the loop ends without finding target, which pointer marks where it belongs?"
    },
    { "name": "Negative numbers", "expr": "search_insert([-9, -4, -1, 3], -5)", "expected": "1", "hidden": true },
    {
      "name": "500 000 values, 3 000 searches",
      "data": "nums = list(range(0, 1_000_000, 2))\nqueries = [i * 333 for i in range(3000)]",
      "expr": "[search_insert(nums, q) for q in queries]",
      "expected": "[(q + 1) // 2 for q in queries]",
      "hidden": true,
      "hint": "A linear scan is too slow here. This is binary search with a different return value."
    }
  ]
}
