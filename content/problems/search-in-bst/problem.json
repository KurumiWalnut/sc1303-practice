{
  "id": "search-in-bst",
  "title": "Search in a BST",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "BST search (Week 11)",
  "leetcode": {
    "number": 700,
    "slug": "search-in-a-binary-search-tree"
  },
  "provided": true,
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Found",
      "expr": "tree_to_list(search_bst(build_tree([4, 2, 7, 1, 3]), 2))",
      "expected": "[2, 1, 3]"
    },
    {
      "name": "Not found",
      "expr": "search_bst(build_tree([4, 2, 7, 1, 3]), 5)",
      "expected": "None"
    },
    {
      "name": "Root",
      "expr": "tree_to_list(search_bst(build_tree([4, 2, 7, 1, 3]), 4))",
      "expected": "[4, 2, 7, 1, 3]",
      "hidden": true
    },
    {
      "name": "Leaf",
      "expr": "tree_to_list(search_bst(build_tree([4, 2, 7, 1, 3]), 7))",
      "expected": "[7]",
      "hidden": true
    },
    {
      "name": "Empty tree",
      "expr": "search_bst(None, 1)",
      "expected": "None",
      "hidden": true
    },
    {
      "name": "Returns the node itself",
      "setup": "root = build_tree([4, 2, 7, 1, 3])",
      "expr": "search_bst(root, 3) is root.left_child.right_child",
      "expected": "True",
      "hidden": true
    },
    {
      "name": "Skewed tree, 20 000 searches",
      "data": "root = build_bst(list(range(300)))\nimport random\nrandom.seed(1)\nqueries = [random.randint(0, 400) for _ in range(20000)]",
      "setup": "found = sum(1 for q in queries if search_bst(root, q) is not None)",
      "expr": "found",
      "expected": "14974",
      "hidden": true
    }
  ]
}
