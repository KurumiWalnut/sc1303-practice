{
  "id": "network-rank",
  "title": "Maximal Network Rank",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Graph representations (Week 12)",
  "leetcode": {
    "number": 1615,
    "slug": "maximal-network-rank"
  },
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Example 1",
      "expr": "maximal_network_rank(4, [[0, 1], [0, 3], [1, 2], [1, 3]])",
      "expected": "4"
    },
    {
      "name": "Example 2",
      "expr": "maximal_network_rank(5, [[0, 1], [0, 3], [1, 2], [1, 3], [2, 3], [2, 4]])",
      "expected": "5"
    },
    {
      "name": "Example 3",
      "expr": "maximal_network_rank(8, [[0, 1], [1, 2], [2, 3], [2, 4], [5, 6], [5, 7]])",
      "expected": "5"
    },
    {
      "name": "No roads",
      "expr": "maximal_network_rank(3, [])",
      "expected": "0",
      "hidden": true
    },
    {
      "name": "The shared road counts once",
      "expr": "maximal_network_rank(2, [[0, 1]])",
      "expected": "1",
      "hidden": true,
      "hint": "A road between the two cities is only counted once."
    },
    {
      "name": "Best pair isn't connected",
      "expr": "maximal_network_rank(6, [[0, 1], [0, 2], [0, 3], [4, 5], [4, 1], [4, 2], [0, 4]])",
      "expected": "7",
      "hidden": true
    },
    {
      "name": "Random small",
      "data": "import random\nrandom.seed(1615)\ncases = []\nfor _ in range(40):\n    n = random.randint(2, 9)\n    cases.append((n, [[a, b] for a in range(n) for b in range(a + 1, n) if random.random() < 0.35]))",
      "expr": "[maximal_network_rank(n, r) for n, r in cases]",
      "expected": "[6, 5, 4, 4, 2, 2, 5, 8, 2, 1, 4, 2, 2, 1, 0, 3, 7, 3, 9, 8, 4, 6, 2, 3, 0, 7, 3, 0, 9, 1, 1, 10, 1, 4, 8, 8, 7, 1, 1, 8]",
      "hidden": true
    },
    {
      "name": "100 cities, 3 000 roads",
      "data": "import random\nrandom.seed(16150)\nall_pairs = [[a, b] for a in range(100) for b in range(a + 1, 100)]\nroads = random.sample(all_pairs, 3000)",
      "expr": "maximal_network_rank(100, roads)",
      "expected": "142",
      "hidden": true
    }
  ]
}
