  "tests": [
    {
      "name": "Example 1",
      "setup": "nums1 = [1, 2, 3, 0, 0, 0]\nmerge(nums1, 3, [2, 5, 6], 3)",
      "expr": "nums1",
      "expected": "[1, 2, 2, 3, 5, 6]"
    },
    {
      "name": "Example 2",
      "setup": "nums1 = [1]\nmerge(nums1, 1, [], 0)",
      "expr": "nums1",
      "expected": "[1]"
    },
    {
      "name": "Example 3",
      "setup": "nums1 = [0]\nmerge(nums1, 0, [1], 1)",
      "expr": "nums1",
      "expected": "[1]"
    },
    {
      "name": "Everything in nums2 is smaller",
      "setup": "nums1 = [4, 5, 6, 0, 0, 0]\nmerge(nums1, 3, [1, 2, 3], 3)",
      "expr": "nums1",
      "expected": "[1, 2, 3, 4, 5, 6]",
      "hidden": true,
      "hint": "Fill from the back so you don't overwrite values in nums1 that you still need."
    },
    {
      "name": "Negative numbers and repeats",
      "setup": "nums1 = [-5, 0, 0, 0, 0]\nmerge(nums1, 2, [-5, -1, 0], 3)",
      "expr": "nums1",
      "expected": "[-5, -5, -1, 0, 0]",
      "hidden": true
    },
    {
      "name": "Random",
      "data": "import random\nrandom.seed(88)\ncases = []\nfor _ in range(30):\n    a = sorted(random.randint(-9, 9) for _ in range(random.randint(0, 6)))\n    b = sorted(random.randint(-9, 9) for _ in range(random.randint(0, 6)))\n    cases.append((a, b))",
      "setup": "results = []\nfor a, b in cases:\n    nums1 = a + [0] * len(b)\n    merge(nums1, len(a), b, len(b))\n    results.append(nums1)",
      "expr": "results",
      "expected": "[[-9, -9, -4, -3, 1, 1, 5, 7], [-2], [-6, -5, -5, -4, -4, 0, 1, 4, 4, 5], [-8, -5, 1, 5], [-9, -2], [-9, 6, 7, 7], [3, 3, 6, 7, 7], [-9, -5, -5, 3], [-9, -5, 0], [-7, -3, 0, 3, 4, 7], [-9, -4, 1, 2, 3, 5, 7, 9], [0, 1, 4, 4, 6, 9], [-2, 0, 2, 4, 4], [], [-7, -2, 0, 7, 8], [-8, -5, 0, 2, 8], [-9, -5, -2, 3, 4, 6], [-5, 0, 0, 6, 7], [-3, 0, 5, 7, 9], [-9, -8, -4, -4, -3, 1, 3, 6], [-8, -2, 0, 1, 2, 3, 3, 3, 9], [1, 2, 3, 5, 8], [-4, -4, -3, 0, 0, 3], [-9, -3, 1, 1, 4, 4, 7, 9], [-9, -6], [-3, 0, 1, 3, 5, 5, 6], [-8, -6, -4, -4, -3, -2, 0, 0, 1, 7], [-7, 1], [-1, 0, 3, 4, 8], [-9, -7, -5, -2, 0, 3, 4]]",
      "hidden": true
    },
    {
      "name": "50 000 + 50 000",
      "data": "import random\nrandom.seed(880)\na = sorted(random.randint(-10**9, 10**9) for _ in range(50000))\nb = sorted(random.randint(-10**9, 10**9) for _ in range(50000))",
      "setup": "nums1 = a + [0] * len(b)\nmerge(nums1, len(a), b, len(b))",
      "expr": "(nums1[:6], nums1[-6:], nums1 == sorted(a + b))",
      "expected": "([-999970284, -999945565, -999931307, -999914837, -999912473, -999899772], [999910436, 999961977, 999969228, 999971226, 999984601, 999996317], True)",
      "hidden": true
    }
  ]
