{
  "id": "middle-of-linked-list",
  "title": "Middle of a linked list",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Linked lists: fast and slow pointers",
  "leetcode": {
    "number": 876,
    "slug": "middle-of-the-linked-list"
  },
  "provided": true,
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Odd length",
      "expr": "middle_node(build_list([1, 2, 3, 4, 5])).data",
      "expected": "3"
    },
    {
      "name": "Even length: second middle",
      "expr": "middle_node(build_list([1, 2, 3, 4, 5, 6])).data",
      "expected": "4"
    },
    {
      "name": "One node",
      "expr": "middle_node(build_list([9])).data",
      "expected": "9"
    },
    {
      "name": "Two nodes",
      "expr": "middle_node(build_list([1, 2])).data",
      "expected": "2",
      "hidden": true,
      "hint": "With two middles, return the second one."
    },
    {
      "name": "Returns the node itself",
      "expr": "to_pylist(middle_node(build_list(['a', 'b', 'c', 'd'])))",
      "expected": "['c', 'd']",
      "hidden": true,
      "hint": "Return the Node, not its value."
    },
    {
      "name": "100 001 nodes",
      "data": "head = build_list(list(range(1, 100002)))",
      "expr": "middle_node(head).data",
      "expected": "50001",
      "hidden": true
    }
  ]
}
