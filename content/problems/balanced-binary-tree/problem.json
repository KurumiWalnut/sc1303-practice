{
  "id": "balanced-binary-tree",
  "title": "Balanced Binary Tree",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "AVL balance (Week 12)",
  "leetcode": {
    "number": 110,
    "slug": "balanced-binary-tree"
  },
  "provided": true,
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "is_balanced(build_tree([3, 9, 20, None, None, 15, 7]))",
      "expected": "True"
    },
    {
      "name": "Example 2",
      "expr": "is_balanced(build_tree([1, 2, 2, 3, 3, None, None, 4, 4]))",
      "expected": "False"
    },
    {
      "name": "Empty tree",
      "expr": "is_balanced(build_tree([]))",
      "expected": "True"
    },
    {
      "name": "Balanced at the root only",
      "expr": "is_balanced(build_tree([1, 2, 2, 3, None, None, 3, 4, None, None, 4]))",
      "expected": "False",
      "hidden": true,
      "hint": "Both of the root's subtrees have height 3, but they aren't balanced inside."
    },
    {
      "name": "One node",
      "expr": "is_balanced(build_tree([7]))",
      "expected": "True",
      "hidden": true
    },
    {
      "name": "Two nodes in a line",
      "expr": "is_balanced(build_tree([1, None, 2]))",
      "expected": "True",
      "hidden": true
    },
    {
      "name": "Three nodes in a line",
      "expr": "is_balanced(build_tree([1, None, 2, None, 3]))",
      "expected": "False",
      "hidden": true
    },
    {
      "name": "800-deep chain",
      "data": "root = build_bst(range(800))",
      "expr": "is_balanced(root)",
      "expected": "False",
      "hidden": true
    },
    {
      "name": "30 000-node balanced BST",
      "data": "order, queue = [], [(0, 30000)]\nfor lo, hi in queue:\n    if lo < hi:\n        mid = (lo + hi) // 2\n        order.append(mid)\n        queue.append((lo, mid))\n        queue.append((mid + 1, hi))\nroot = build_bst(order)",
      "expr": "is_balanced(root)",
      "expected": "True",
      "hidden": true
    },
    {
      "name": "Big tree, unbalanced deep inside",
      "data": "order, queue = [], [(0, 30000)]\nfor lo, hi in queue:\n    if lo < hi:\n        mid = (lo + hi) // 2\n        order.append(mid)\n        queue.append((lo, mid))\n        queue.append((mid + 1, hi))\nroot = build_bst(order + [-1, -2])",
      "expr": "is_balanced(root)",
      "expected": "False",
      "hidden": true
    }
  ]
}
