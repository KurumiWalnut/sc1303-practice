{
  "id": "reverse-string",
  "title": "Reverse String",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Week 5 seminar, exercise 1 (reverse an array)",
  "leetcode": {
    "number": 344,
    "slug": "reverse-string"
  },
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Example 1",
      "setup": "s = list(\"hello\")\nreverse_string(s)",
      "expr": "s",
      "expected": "['o', 'l', 'l', 'e', 'h']"
    },
    {
      "name": "Example 2",
      "setup": "s = list(\"Hannah\")\nreverse_string(s)",
      "expr": "s",
      "expected": "['h', 'a', 'n', 'n', 'a', 'H']"
    },
    {
      "name": "Returns nothing, changes s",
      "setup": "s = list(\"ab\")\nresult = reverse_string(s)",
      "expr": "(result, s)",
      "expected": "(None, ['b', 'a'])",
      "hidden": true,
      "hint": "Swap inside the list you were given. s = s[::-1] only changes your local name."
    },
    {
      "name": "One character",
      "setup": "s = [\"x\"]\nreverse_string(s)",
      "expr": "s",
      "expected": "['x']",
      "hidden": true
    },
    {
      "name": "Empty",
      "setup": "s = []\nreverse_string(s)",
      "expr": "s",
      "expected": "[]",
      "hidden": true
    },
    {
      "name": "100 000 characters",
      "data": "text = list('abcdefghij' * 10000)",
      "setup": "s = text\nreverse_string(s)",
      "expr": "(s[:10], s[-10:])",
      "expected": "(['j', 'i', 'h', 'g', 'f', 'e', 'd', 'c', 'b', 'a'], ['j', 'i', 'h', 'g', 'f', 'e', 'd', 'c', 'b', 'a'])",
      "hidden": true
    }
  ]
}
