{
  "id": "binary-search-impl",
  "title": "Binary search",
  "kind": "base",
  "difficulty": "Easy",
  "source": "Week 6 lecture and seminar",
  "leetcode": { "number": 704, "slug": "binary-search" },
  "timeLimitMs": 3000,
  "tests": [
    { "name": "Lecture example", "expr": "binary_search([2, 4, 6, 8, 10, 12, 14, 16, 18], 14)", "expected": "6" },
    { "name": "Seminar example (not found)", "expr": "binary_search([3, 17, 75, 80, 202], 22)", "expected": "-1" },
    { "name": "One element", "expr": "binary_search([5], 5)", "expected": "0" },
    { "name": "Empty array", "expr": "binary_search([], 7)", "expected": "-1", "hidden": true, "hint": "An empty array has nothing to find." },
    { "name": "First element", "expr": "binary_search([1, 3, 5, 7, 9, 11], 1)", "expected": "0", "hidden": true },
    { "name": "Last element", "expr": "binary_search([1, 3, 5, 7, 9, 11], 11)", "expected": "5", "hidden": true, "hint": "Check the loop still runs when low == high." },
    { "name": "Smaller than everything", "expr": "binary_search([10, 20, 30], 5)", "expected": "-1", "hidden": true },
    { "name": "Bigger than everything", "expr": "binary_search([10, 20, 30], 35)", "expected": "-1", "hidden": true },
    { "name": "Negative numbers", "expr": "binary_search([-40, -12, -3, 0, 8], -12)", "expected": "1", "hidden": true },
    {
      "name": "Every value in an even-length array",
      "expr": "[binary_search([1, 3, 5, 7, 9, 11, 13, 15], v) for v in range(0, 17)]",
      "expected": "[-1, 0, -1, 1, -1, 2, -1, 3, -1, 4, -1, 5, -1, 6, -1, 7, -1]",
      "hidden": true
    },
    {
      "name": "500 000 values, 3 000 searches",
      "data": "array = list(range(0, 1_000_000, 2))\nqueries = [i * 333 for i in range(3000)]",
      "expr": "[binary_search(array, q) for q in queries]",
      "expected": "[q // 2 if q % 2 == 0 else -1 for q in queries]",
      "hidden": true,
      "hint": "Checking elements one by one is too slow here. Halve the range on every step."
    }
  ]
}
