{
  "id": "running-median",
  "title": "Running median with insertion",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Insertion sort (Week 7): sorting as values arrive",
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Example 1",
      "expr": "running_medians([5, 15, 1, 3])",
      "expected": "[5.0, 10.0, 5.0, 4.0]"
    },
    {
      "name": "Example 2",
      "expr": "running_medians([2, 2])",
      "expected": "[2.0, 2.0]"
    },
    {
      "name": "Decreasing",
      "expr": "running_medians([9, 7, 5, 3, 1])",
      "expected": "[9.0, 8.0, 7.0, 6.0, 5.0]",
      "hidden": true
    },
    {
      "name": "Negative numbers",
      "expr": "running_medians([-1, -5, 4, 0])",
      "expected": "[-1.0, -3.0, -1.0, -0.5]",
      "hidden": true
    },
    {
      "name": "Random small",
      "data": "import random\nrandom.seed(4321)\narrays = [[random.randint(-9, 9) for _ in range(random.randint(1, 9))] for _ in range(30)]",
      "expr": "[running_medians(a) for a in arrays]",
      "expected": "[[-8.0, -2.0, -7.0, -5.5, -4.0], [-8.0, -6.0], [6.0], [4.0, 1.0, 3.0, 3.5, 4.0], [5.0, -2.0, -6.0], [-5.0, 0.0, -2.0, -1.5, -1.0, -1.5, -1.0, 0.0, 1.0], [6.0, 1.5, 0.0, -1.0], [4.0, 3.5, 3.0, -1.5, 1.0, 0.0], [-3.0, -0.5, -2.0, -2.5], [3.0, 4.0, 3.0, 3.5, 3.0], [6.0, 7.0, 6.0, 0.0, 0.0], [-8.0], [-1.0, -4.0, -1.0, 3.0], [3.0], [4.0, 2.5, 4.0, 2.5, 1.0, -1.0, 1.0, 0.0, -1.0], [9.0, 8.5], [4.0, 6.5, 8.0, 6.0, 4.0, 0.0, 0.0, 1.5], [-2.0, 3.0, -2.0, 3.0, 6.0], [0.0, 0.5, 0.0, -1.5, 0.0, 0.5, 1.0], [-9.0, -4.5, 0.0, -0.5], [-6.0], [-3.0], [-3.0, -1.0, 1.0, -1.0], [3.0, 2.0, 1.0, -0.5, -2.0, -0.5, -2.0, -2.5], [-5.0, -5.5], [-7.0, -3.5], [0.0, -3.5, -4.0, -2.0], [-5.0, 1.5, 6.0, 0.5, -4.0, 1.0, -3.0, 1.5], [-4.0, 2.0], [1.0, -2.5]]",
      "hidden": true
    },
    {
      "name": "3 000 numbers",
      "data": "import random\nrandom.seed(43210)\nnums = [random.randint(-10**6, 10**6) for _ in range(3000)]",
      "setup": "r = running_medians(nums)",
      "expr": "(len(r), r[:6], r[-3:], sum(r))",
      "expected": "(3000, [377362.0, 501303.5, 377362.0, 501303.5, 442889.0, 410125.5], [42149.0, 41319.0, 41175.5], 178155138.0)",
      "hidden": true
    }
  ]
}
