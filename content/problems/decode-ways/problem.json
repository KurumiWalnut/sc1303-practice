{
  "id": "decode-ways",
  "title": "Decode Ways",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Memoization (Week 10)",
  "leetcode": {
    "number": 91,
    "slug": "decode-ways"
  },
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "num_decodings(\"12\")",
      "expected": "2"
    },
    {
      "name": "Example 2",
      "expr": "num_decodings(\"226\")",
      "expected": "3"
    },
    {
      "name": "Example 3",
      "expr": "num_decodings(\"06\")",
      "expected": "0"
    },
    {
      "name": "Zeros",
      "expr": "[num_decodings(\"10\"), num_decodings(\"2101\"), num_decodings(\"100\"), num_decodings(\"11106\"), num_decodings(\"0\")]",
      "expected": "[1, 1, 0, 2, 0]",
      "hidden": true,
      "hint": "A 0 can only be decoded as the second digit of 10 or 20."
    },
    {
      "name": "27 and above take one digit",
      "expr": "[num_decodings(\"27\"), num_decodings(\"99\"), num_decodings(\"262\")]",
      "expected": "[1, 1, 2]",
      "hidden": true
    },
    {
      "name": "Random strings",
      "data": "import random\nrandom.seed(91)\nstrs = [''.join(random.choice('0122223456') for _ in range(random.randint(1, 12))) for _ in range(60)]",
      "expr": "[num_decodings(s) for s in strs]",
      "expected": "[1, 10, 9, 4, 2, 0, 6, 6, 6, 0, 0, 39, 8, 0, 6, 5, 15, 8, 1, 1, 12, 4, 0, 13, 36, 21, 12, 0, 32, 4, 1, 60, 6, 72, 10, 0, 1, 1, 1, 5, 18, 10, 16, 3, 1, 0, 0, 3, 3, 20, 0, 0, 0, 5, 1, 0, 8, 9, 1, 0]",
      "hidden": true
    },
    {
      "name": "100 ones",
      "expr": "num_decodings(\"1\" * 100)",
      "expected": "573147844013817084101",
      "hidden": true,
      "hint": "Without a memo this makes about 10^20 calls."
    },
    {
      "name": "Long mixed string",
      "data": "import random\nrandom.seed(910)\ns = ''.join(random.choice('1212126') for _ in range(100))",
      "expr": "num_decodings(s)",
      "expected": "5442700762699200000",
      "hidden": true
    }
  ]
}
