{
  "id": "coin-change",
  "title": "Coin Change",
  "kind": "leetcode",
  "difficulty": "Medium",
  "source": "Dynamic programming (Week 10)",
  "leetcode": {
    "number": 322,
    "slug": "coin-change"
  },
  "timeLimitMs": 3000,
  "hints": 2,
  "tests": [
    {
      "name": "Example 1",
      "expr": "coin_change([1, 2, 5], 11)",
      "expected": "3"
    },
    {
      "name": "Example 2",
      "expr": "coin_change([2], 3)",
      "expected": "-1"
    },
    {
      "name": "Example 3",
      "expr": "coin_change([1], 0)",
      "expected": "0"
    },
    {
      "name": "Greedy fails",
      "expr": "coin_change([1, 3, 4], 6)",
      "expected": "2",
      "hidden": true,
      "hint": "Biggest-coin-first doesn't always give the fewest coins."
    },
    {
      "name": "Greedy gets stuck",
      "expr": "coin_change([5, 7], 24)",
      "expected": "4",
      "hidden": true
    },
    {
      "name": "Random small",
      "data": "import random\nrandom.seed(322)\ncases = [(random.sample(range(1, 30), random.randint(1, 4)), random.randint(0, 120)) for _ in range(40)]",
      "expr": "[coin_change(c, a) for c, a in cases]",
      "expected": "[4, -1, 3, 2, -1, 8, -1, -1, -1, -1, -1, -1, 7, -1, 10, -1, -1, 2, -1, 7, -1, 3, -1, -1, -1, 2, -1, -1, -1, -1, -1, 5, 6, 6, -1, -1, 3, 9, 2, 7]",
      "hidden": true
    },
    {
      "name": "Amount 10 000",
      "expr": "[coin_change([186, 419, 83, 408], 6249), coin_change([3, 7, 405, 436], 8839), coin_change([2, 4, 6], 9999)]",
      "expected": "[20, 25, -1]",
      "hidden": true,
      "hint": "Fill the table bottom-up. Recursion 10 000 calls deep hits Python's limit."
    },
    {
      "name": "Twelve coins",
      "data": "import random\nrandom.seed(3220)\ncoins = random.sample(range(7, 500), 12)",
      "expr": "coin_change(coins, 10000)",
      "expected": "23",
      "hidden": true
    }
  ]
}
