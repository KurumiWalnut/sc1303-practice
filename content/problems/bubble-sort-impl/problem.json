{
  "id": "bubble-sort-impl",
  "title": "Bubble sort with early exit",
  "kind": "base",
  "difficulty": "Easy",
  "source": "Week 7 lecture (Big O of Sorting); Week 7 seminar, exercise 1",
  "timeLimitMs": 3000,
  "tests": [
    {
      "name": "Reverse order (worst case)",
      "setup": "a = [5, 4, 3, 2, 1]",
      "expr": "(bubble_sort(a), a)",
      "expected": "((10, 10), [1, 2, 3, 4, 5])"
    },
    {
      "name": "Already sorted (early exit)",
      "setup": "a = [1, 2, 3, 4, 5]",
      "expr": "(bubble_sort(a), a)",
      "expected": "((4, 0), [1, 2, 3, 4, 5])"
    },
    {
      "name": "Mixed",
      "setup": "a = [4, 2, 7, 1, 3]",
      "expr": "(bubble_sort(a), a)",
      "expected": "((10, 6), [1, 2, 3, 4, 7])"
    },
    {
      "name": "Empty and one value",
      "expr": "(bubble_sort([]), bubble_sort([9]))",
      "expected": "((0, 0), (0, 0))",
      "hidden": true
    },
    {
      "name": "Equal values aren't swapped",
      "setup": "a = [2, 1, 2, 1]",
      "expr": "(bubble_sort(a), a)",
      "expected": "((6, 3), [1, 1, 2, 2])",
      "hidden": true,
      "hint": "Only swap when the left value is strictly bigger."
    },
    {
      "name": "The range shrinks",
      "expr": "bubble_sort([3, 1, 2, 4, 5, 6])",
      "expected": "(9, 2)",
      "hidden": true,
      "hint": "After each pass, the next pass stops one position earlier."
    },
    {
      "name": "2 000 random values",
      "data": "import random\nrandom.seed(77)\nvalues = [random.randint(0, 10**6) for _ in range(2000)]",
      "setup": "a = values[:]",
      "expr": "(bubble_sort(a), a == sorted(values))",
      "expected": "((1997047, 1013266), True)",
      "hidden": true
    },
    {
      "name": "30 000 values, already sorted",
      "setup": "a = list(range(30000))",
      "expr": "bubble_sort(a)",
      "expected": "(29999, 0)",
      "hidden": true,
      "hint": "If a pass makes no swaps, the array is sorted: stop."
    }
  ]
}
