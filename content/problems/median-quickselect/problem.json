{
  "id": "median-quickselect",
  "title": "Median with quickselect",
  "kind": "leetcode",
  "difficulty": "Easy",
  "source": "Quickselect (Week 10)",
  "timeLimitMs": 3000,
  "hints": 1,
  "tests": [
    {
      "name": "Example 1",
      "expr": "median([3, 1, 2])",
      "expected": "2"
    },
    {
      "name": "Example 2",
      "expr": "median([7, 1, 9, 4, 4])",
      "expected": "4"
    },
    {
      "name": "One value",
      "expr": "median([42])",
      "expected": "42",
      "hidden": true
    },
    {
      "name": "Negative numbers",
      "expr": "median([-5, -1, -3, 10, 0])",
      "expected": "-1",
      "hidden": true
    },
    {
      "name": "All the same",
      "expr": "median([6, 6, 6, 6, 6])",
      "expected": "6",
      "hidden": true
    },
    {
      "name": "Doesn't care about the input order",
      "expr": "[median(p) for p in ([1, 2, 3, 4, 5], [5, 4, 3, 2, 1], [2, 5, 1, 4, 3])]",
      "expected": "[3, 3, 3]",
      "hidden": true
    },
    {
      "name": "201 random",
      "data": "import random\nrandom.seed(5)\nnums = [random.randint(0, 50) for _ in range(201)]",
      "expr": "median(nums)",
      "expected": "22",
      "hidden": true
    },
    {
      "name": "200 001 random",
      "data": "import random\nrandom.seed(55)\nnums = [random.randint(-10**9, 10**9) for _ in range(200001)]",
      "expr": "median(nums)",
      "expected": "-1633299",
      "hidden": true
    },
    {
      "name": "200 001 sorted",
      "data": "nums = list(range(200001))",
      "expr": "median(nums)",
      "expected": "100000",
      "hidden": true,
      "hint": "With the last element as the pivot, sorted input is the worst case. Pick a random pivot."
    }
  ]
}
